{
  "name": "chiveproxy2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx vp dev --host 0.0.0.0",
    "build": "tsc -b && vp build",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "preview": "vp preview",
    "prerender": "bun run scripts/prerender.ts",
    "serve": "bun run src/serve.ts",
    "prepare": "husky",
    "test-server": "bun run src/test-server.ts"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "@tanstack/react-query": "^5.103.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-loader-spinner": "^8.0.2",
    "react-router": "^8.4.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "sass-embedded": "^1.105.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
